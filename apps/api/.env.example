# Copy this file to `.env` (same folder) and change values if you need to.
# `.env` is gitignored: real secrets go there and never into Git.

# Where the API finds Postgres. This default matches docker-compose.yml.
EMBR_DATABASE_URL=postgresql+asyncpg://embr:embr@localhost:5432/embr

# local, test or production
EMBR_ENVIRONMENT=local
